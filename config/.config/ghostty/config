# Vim-style pane navigation with Ctrl+h/j/k/l
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

# Make the focused pane stand out by dimming others.
#unfocused-split-opacity = 0.75
#unfocused-split-fill = #000000
#split-divider-color = #3E4451

# Gruvbox theme
# theme = GruvboxDark
theme = Monokai Remastered

