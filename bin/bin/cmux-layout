#!/bin/bash

dir="${1:-$PWD}"
window_name="cmux"
session_name="cmux"

if [[ ! -d "$dir" ]]; then
  echo "Directory not found: $dir" >&2
  exit 1
fi

if [[ -n "${TMUX:-}" ]]; then
  session_name="$(tmux display-message -p '#S')"
  tmux new-window -n "$window_name" -c "$dir"
else
  if tmux has-session -t "$session_name" 2>/dev/null; then
    tmux new-window -t "$session_name" -n "$window_name" -c "$dir"
  else
    tmux new-session -ds "$session_name" -n "$window_name" -c "$dir"
  fi
fi

target="$session_name:$window_name"

# Left narrow pane, right wide pane.
right_pane="$(tmux split-window -h -p 75 -t "$target" -c "$dir" -P -F "#{pane_id}")"

# Split the right pane into top/bottom.
tmux split-window -v -p 30 -t "$right_pane" -c "$dir" >/dev/null
tmux select-pane -t "$right_pane"

if [[ -z "${TMUX:-}" ]]; then
  tmux attach -t "$session_name"
fi
